{
  "name": "annasetu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c green,blue \"vite\" \"npm --prefix server run dev\"",
    "dev:web": "vite",
    "dev:api": "npm --prefix server run dev",
    "build": "vite build",
    "preview": "vite preview",
    "setup": "npm install && npm --prefix server install && npm --prefix server run seed",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "render:build": "npm install && npm --prefix server install && npm run build",
    "render:start": "npm --prefix server start"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
