# Copy to server/.env. All optional in development.
PORT=4000

# ── Database ──────────────────────────────────────────────────────
# Set this and the API runs on PostgreSQL. Comment it out and it falls
# back to a JSON file at server/data/db.json, which needs nothing installed.
DATABASE_URL=postgres://annasetu:annasetu@localhost:5432/annasetu

# Managed providers (Neon, Supabase, Render) require TLS. Uncomment for those.
# PGSSLMODE=require

# Used by `npm run test:pg` only. Must be a DIFFERENT database — the suite
# wipes it on every run.
# TEST_DATABASE_URL=postgres://annasetu:annasetu@localhost:5432/annasetu_test
JWT_SECRET=change-me-in-production
JWT_TTL=8h
CORS_ORIGIN=http://localhost:5173
SLOT_CAPACITY=8

# ── Offline booking helpline ──────────────────────────────────────
HELPLINE_NUMBER=1967
HELPLINE_SMS_KEYWORD=RATION
HELPLINE_SMS_SHORTCODE=51969
HELPLINE_HOURS=7 AM – 9 PM, all days
HELPLINE_LANGUAGES=Telugu,Hindi,English

# Households sign in with a card PIN set at the shop counter, so the system
# makes no outbound request of any kind. There is no gateway to configure and
# nothing metered to run out of.
